{
  "MongoDb": { "ConnectionString": "mongodb://localhost:27017", "DatabaseName": "EduManageLms" },
  "Jwt": { "Issuer": "EduManageLms", "Audience": "EduManageLms.Client", "Key": "DEVELOPMENT_ONLY_CHANGE_TO_AT_LEAST_32_CHARACTERS", "AccessTokenMinutes": 20, "RefreshTokenDays": 7 },
  "Backup": { "Directory": "./backups", "MongoDumpPath": "mongodump", "MongoRestorePath": "mongorestore" },
  "AllowedOrigins": ["http://localhost:4200", "http://localhost:8081"],
  "Serilog": { "MinimumLevel": { "Default": "Information", "Override": { "Microsoft": "Warning" } }, "WriteTo": [{ "Name": "Console" }, { "Name": "File", "Args": { "path": "logs/lms-.log", "rollingInterval": "Day" } }] }
}
